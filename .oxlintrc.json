{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "coverage/**", "vendor/**", "test/snapshots/**"],
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "react-refresh/only-export-components": "warn"
  }
}
